# VIRALCLIP AI — variables de entorno (SIN valores reales; copia a .env)
# Base de datos: SQLite para desarrollo; Postgres en producción
DATABASE_URL=sqlite:///./viralclip.db
# DATABASE_URL=postgresql://usuario:contrasena@host:5432/viralclip
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/storage
# S3 / Cloudflare R2 (solo si STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
# Twitch (opcional; sin ellas la validación en vivo devuelve requires_credentials)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# YouTube Data API v3 (opcional; sin ella el estado en vivo no es verificable)
YOUTUBE_API_KEY=
# Whisper (por defecto small en CPU; large-v3-turbo necesita más RAM/GPU)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Límites
MAX_CONCURRENT_STREAMS=3
DEFAULT_ACTIVE_STREAMS=1
CLIP_RETENTION_DAYS=7
STORAGE_QUOTA_GB=10
MAX_UPLOAD_GB=2

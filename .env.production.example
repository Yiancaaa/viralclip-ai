# VIRALCLIP AI — variables de entorno para PRODUCCIÓN (camino A: Oracle + R2).
# Copia a .env y rellena SOLO los valores que te falten. SIN valores reales
# en este archivo: nunca se versiona un .env con secretos.
# Para el camino B (Render + Supabase), usa los valores de la columna B
# de docs/DESPLIEGUE.md §5 (DATABASE_URL de Supabase, endpoint S3 de
# Supabase, S3_ADDRESSING_STYLE=path, STORAGE_QUOTA_GB=1, WHISPER_MODEL=tiny).

# --- General ---
ENVIRONMENT=production
PORT=8000

# --- Base de datos (Postgres en el servidor, servicio db del compose) ---
# La contraseña DEBE coincidir con POSTGRES_PASSWORD de abajo.
DATABASE_URL=postgresql://viralclip:TU_CONTRASENA_POSTGRES@db:5432/viralclip
POSTGRES_PASSWORD=TU_CONTRASENA_POSTGRES

# --- Almacenamiento: Cloudflare R2 (camino A) ---
STORAGE_BACKEND=s3
# Endpoint R2: https://<TU_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=https://TU_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=TU_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=TU_R2_SECRET_ACCESS_KEY
S3_BUCKET=viralclip-ai
S3_REGION=auto
# R2 usa direccionamiento virtual-hosted (auto). Para Supabase Storage
# (camino B) cambia a: S3_ADDRESSING_STYLE=path
S3_ADDRESSING_STYLE=auto

# --- Plataformas (opcionales; sin ellas la validación en vivo devuelve
# requires_credentials y nunca inventa si un canal está en directo) ---
# Twitch: crea la app en dev.twitch.tv/console (ver docs/CONECTORES.md §2)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# YouTube: clave de YouTube Data API v3 (ver docs/CONECTORES.md §4)
YOUTUBE_API_KEY=

# --- Whisper: transcripción en CPU del servidor (sin GPU en el camino 0 $) ---
# small en Oracle (12 GB RAM). En Render (512 MB) usa tiny.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Límites (presupuesto 0 $: nada de pago por defecto) ---
MAX_CONCURRENT_STREAMS=3
DEFAULT_ACTIVE_STREAMS=1
CLIP_RETENTION_DAYS=7
# Tope de almacenamiento: 10 GB en R2 (plan gratuito), 1 GB en Supabase.
STORAGE_QUOTA_GB=10
MAX_UPLOAD_GB=2
